    "answer_ask": {
      "method": "POST",
      "path": "/asks/{askID}/answer",
      "call": "AnswerAskWithMinutes",
      "action": "market.ask.answer",
      "tool": "market_answer_ask",
      "title": "Answer an ask",
      "description": "The poster answers yes with a date, or no. A yes may point at one of his offers, quote a price or say how many minutes away he is. Silence stays waiting and a reply never opens an order.",
      "args": [
        {
          "from": "caller",
          "as": "caller",
          "description": "Who is acting, supplied by the mount. Never read from the request."
        },
        {
          "from": "path",
          "as": "askID",
          "refers": "market.ask",
          "description": "The ask."
        },
        {
          "from": "body",
          "as": "answer",
          "description": "yes or no.",
          "required": true
        },
        {
          "from": "body",
          "as": "date",
          "description": "The date promised, required with yes."
        },
        {
          "from": "body",
          "as": "note",
          "description": "A free note."
        },
        {
          "from": "body",
          "as": "offer_id",
          "refers": "market.offer",
          "description": "One of this poster's offers, with yes."
        },
        {
          "from": "body",
          "as": "price",
          "description": "A price quoted with yes."
        },
        {
          "from": "body",
          "as": "minutes",
          "description": "Minutes away, with yes."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
