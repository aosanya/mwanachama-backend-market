        {
          "name": "id",
          "type": "string",
          "description": "Storage key, minted by the server.",
          "primary": true
        },
        {
          "name": "poster_id",
          "type": "string",
          "description": "The poster who posted it.",
          "required": true
        },
        {
          "name": "product_words",
