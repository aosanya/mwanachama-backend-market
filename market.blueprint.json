        {
          "name": "bulk_min",
          "type": "float",
          "description": "Smallest amount that earns the bulk price."
        },
        {
          "name": "bulk_price",
          "type": "float",
          "description": "Price per unit at or above the bulk minimum."
        },
        {
          "name": "product",
          "type": "string",
          "description": "The product the AI grouped it under."
        },
        {
          "name": "posted_at",
          "type": "timestamp",
          "description": "When it was posted."
        }
      ],
      "indexes": [
        {
          "name": "poster",
          "description": "Reads poster.",
          "fields": [
            "poster_id"
          ]
        },
        {
          "name": "product",
          "description": "Reads product.",
          "fields": [
            "product"
          ]
        }
      ]
    },
