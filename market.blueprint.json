{
  "module": "market",
  "objects": [
    {
      "role": "poster",
      "description": "Someone who posts what he has on offer to the people of an agency, and who is approved before he is shown.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "description": "Storage key, minted by the server.",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "description": "His name as the agency shows it.",
          "required": true
        },
        {
          "name": "area",
          "type": "string",
          "description": "Where he is."
        },
        {
          "name": "posts",
          "type": "text",
          "description": "What he posts, in his words."
        },
        {
          "name": "owner",
          "type": "string",
          "description": "The actor who applied, bound from the caller."
        },
        {
          "name": "approved_by",
          "type": "string",
          "description": "The actor who approved him, bound from the caller."
        },
        {
          "name": "status",
          "type": "enum",
          "description": "Where his application stands.",
          "values": [
            "pending",
            "approved",
            "declined",
            "removed"
          ],
          "default": "pending"
        },
        {
          "name": "availability",
          "type": "enum",
          "description": "Whether he is taking asks now.",
          "values": [
            "available",
            "away"
          ],
          "default": "available"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "description": "When the row was created."
        }
      ],
      "indexes": [
        {
          "name": "status",
          "description": "Reads status.",
          "fields": [
            "status"
          ]
        }
      ]
    },
    {
      "role": "offer",
